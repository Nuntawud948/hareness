# =====================================================================
# Standalone Multi-LLM Provider Router for LINE & Telegram
# Clean Architecture Environment Configuration
# =====================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SERVER_URL=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://harness:harness_pass@localhost:5432/harness_db?schema=public"

# Database Container Defaults (used by docker-compose)
POSTGRES_DB=harness_db
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_pass
POSTGRES_PORT=5432

# Security & Encryption
# ENCRYPTION_SECRET must be exactly 32 bytes (64 hex characters)
# Example generated via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Web Dashboard Admin Authentication
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by Prisma seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Rate Limiting (sliding window per user)
RATE_LIMIT_MAX_PER_MINUTE=10

# Conversation Context Settings
MAX_CONVERSATION_HISTORY=20
HISTORY_RETENTION_DAYS=30

# NOTE:
# - LLM API keys (Gemini, OpenAI, Claude, DeepSeek, Groq) are managed dynamically via the Web UI!
# - Bot credentials (LINE Channel Secret/Token, Telegram Bot Token) are managed dynamically via the Web UI!
